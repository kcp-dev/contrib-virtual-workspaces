# Tilt for the contrib virtual workspaces: kcp itself comes from the kcp
# repo's own Tilt setup (included below, unchanged), and this repo's
# components run on top as live-reloading local processes against it.
#
#   hack/tilt/up.sh          create the kind cluster and start tilt
#   KCP_DIR=/path/to/kcp     where the kcp checkout lives (default ../kcp)
#   KCP_STATIC=false         build kcp from the checkout's sources instead
#                            of running the published, version-matched
#                            images (the default is static: this repo
#                            develops AGAINST kcp, not kcp itself; pin
#                            with KCP_IMAGE_REPO/KCP_IMAGE_TAG)
#   TENANCY_ENABLED=false    skip a component (also MARKETPLACE_ENABLED)
#
# What you get:
#   - everything kcp's contrib/tilt deploys (operator, shards, front-proxy
#     behind an envoy gateway on https://kcp.localhost:8443, observability,
#     optionally the dashboard),
#   - admin kubeconfigs extracted into .tilt/ (tilt-frontproxy.kubeconfig,
#     tilt-root.kubeconfig, tilt-theseus.kubeconfig),
#   - per component: a build resource (rebuilds on source changes), an
#     init resource (re-applies the exports — they are embedded in the
#     binary, so a rebuilt binary re-runs init), and operator + virtual
#     workspace processes that restart when the binary changes.

KCP_DIR = os.getenv('KCP_DIR', '../kcp')
if not os.path.exists(KCP_DIR + '/contrib/tilt/Tiltfile'):
    fail('no kcp checkout at %s — set KCP_DIR to your github.com/kcp-dev/kcp clone' % KCP_DIR)

# kcp's extract-kubeconfig.bash honors this: the admin kubeconfigs land in
# OUR .tilt/ instead of the kcp repo root.
TILT_DIR = os.getcwd() + '/.tilt'
os.putenv('KCP_KUBECONFIG_DIR', TILT_DIR)

# Static mode: the operator's default image tag (a release, v0.33.x) lags
# what these Tiltfiles and this repo are developed against. Track kcp main
# unless the caller pinned something else with KCP_IMAGE_REPO/KCP_IMAGE_TAG.
if os.getenv('KCP_IMAGE_TAG') == None:
    os.putenv('KCP_IMAGE_TAG', 'main')

# The dashboard lives in yet another sibling checkout; only keep kcp's
# default-on behavior when it is actually there.
if os.getenv('KCP_PORTAL_ENABLED') == None and not os.path.exists(KCP_DIR + '/../contrib-dashboard/Dockerfile'):
    os.putenv('KCP_PORTAL_ENABLED', 'false')

# Dex: an in-cluster OIDC issuer shared by kcp and the virtual workspaces,
# so `contribctl login` works against this environment. One
# issuer URL serves both sides: the host reaches it through the :8443
# ingress port-forward, the kcp pods through their gateway hostAliases.
# Disable with DEX_ENABLED=false.
DEX_ENABLED = os.getenv('DEX_ENABLED', 'true').lower() not in ('false', '0', 'no', 'off')
DEX_ISSUER = 'https://dex.kcp.localhost:8443/dex'
DEX_HOSTNAME = 'dex.kcp.localhost'

# ── kcp itself ───────────────────────────────────────────────────────
# kcp's contrib/tilt ships two entry points: Tiltfile.static (published
# images, operator CRs generated by kcp_static.Tiltfile's deploy_kcp) and
# Tiltfile (built from source, hand-written CRs). Neither knows about an
# OIDC issuer, and an include() cannot be parameterized — so for the static
# path this file repeats the entry point's dozen lines and calls deploy_kcp
# itself, with dex as the issuer and dex's hostname among the hostAliases.
# Everything path-like is addressed through KCP_DIR so it tracks the kcp
# checkout rather than copying it.
#
# This replaced an earlier hand-off through KCP_OIDC_* environment variables
# that kcp's Tiltfile never actually read: with them, every kcp pod came up
# without an OIDC authenticator, and every dex token was "invalid bearer
# token" at the front-proxy. If kcp's entry point grows an oidc parameter,
# this block can shrink back to an include().
KCP_TILT = KCP_DIR + '/contrib/tilt'
KCP_STATIC = os.getenv('KCP_STATIC', 'true').lower() not in ('false', '0', 'no', 'off')

load('ext://helm_remote', 'helm_remote')
load('ext://namespace', 'namespace_create')
load('ext://cert_manager', 'deploy_cert_manager')
# load() is top-level only and takes only a string literal, and KCP_DIR is
# neither; a symlink under .tilt gives it a fixed path to a movable target.
local('mkdir -p "%s" && ln -sfn "%s" "%s/kcp"' % (TILT_DIR, os.path.abspath(KCP_DIR), TILT_DIR), quiet=True)
load('./.tilt/kcp/contrib/tilt/kcp_static.Tiltfile', 'deploy_kcp')

if KCP_STATIC:
    k8s_yaml(KCP_TILT + '/kernel-limits-job.yaml')
    deploy_cert_manager(version='v1.19.2')
    k8s_yaml(KCP_TILT + '/issuer.yaml')

    namespace_create('envoy-gateway-system')
    helm_remote(
        'gateway-helm',
        repo_url='oci://registry-1.docker.io/envoyproxy',
        repo_name='gateway-helm',
        release_name='envoy',
        namespace='envoy-gateway-system',
        version='v1.7.0',
        values=[],
        set=[],
    )
    k8s_yaml(KCP_TILT + '/gateway.yaml')
    # kcp's own `ingress` port-forward is left out: ingress-forward below does
    # the same job with a readiness probe.

    if os.getenv('KCP_OBSERVABILITY_ENABLED', 'true').lower() not in ('false', '0', 'no', 'off'):
        include(KCP_TILT + '/observability/Tiltfile')
    else:
        print('Observability stack disabled (KCP_OBSERVABILITY_ENABLED=false)')

    k8s_yaml(kustomize(KCP_TILT + '/etcd'))
    k8s_yaml(kustomize(KCP_TILT + '/kcp-operator'))

    kcp_overrides = {
        'image_repo': os.getenv('KCP_IMAGE_REPO', ''),
        'image_tag': os.getenv('KCP_IMAGE_TAG', ''),
        'token_auth_secret': os.getenv('KCP_TOKEN_AUTH_SECRET', None) or None,
        'token_auth_key': os.getenv('KCP_TOKEN_AUTH_KEY', None) or None,
        'kubeconfig_dir': TILT_DIR,
    }
    if DEX_ENABLED:
        # The same block the production chart takes. caFileRef is the dex-tls
        # secret this file creates below — kcp reads dex's CA from it, which
        # is why the secret is the source of truth for dex's certificate.
        kcp_overrides['oidc'] = {
            'issuerURL': DEX_ISSUER,
            'clientID': 'kcp',
            'usernameClaim': 'email',
            'groupsClaim': 'groups',
            'caFileRef': {'name': 'dex-tls', 'key': 'ca.crt'},
        }
        # deploy_kcp derives the kcp hostnames from the base domain; dex's
        # has to be added so the pods resolve the issuer through the gateway.
        kcp_overrides['hostnames'] = [
            'kcp.localhost', 'root.kcp.localhost', 'theseus.kcp.localhost', DEX_HOSTNAME,
        ]
    deploy_kcp(base_domain='kcp.localhost', extra_shards=['theseus'], **kcp_overrides)

    if os.getenv('KCP_PORTAL_ENABLED', 'true').lower() not in ('false', '0', 'no', 'off'):
        DASHBOARD_DIR = os.getenv('KCP_PORTAL_DIR', KCP_DIR + '/../contrib-dashboard')
        manifest = DASHBOARD_DIR + '/deploy/deployment.yaml'
        if not os.path.exists(manifest):
            fail('contrib-dashboard not found at %s — set KCP_PORTAL_DIR to your checkout ' % DASHBOARD_DIR +
                 'or disable the portal with KCP_PORTAL_ENABLED=false')
        portal_image = os.getenv('KCP_PORTAL_IMAGE', 'ghcr.io/kcp-dev/contrib-dashboard:main')
        dashboard_yaml = str(read_file(manifest)).replace('image: kcp-dashboard', 'image: ' + portal_image)
        k8s_yaml(blob(dashboard_yaml))
        k8s_resource('kcp-dashboard',
            port_forwards=['8080:8080'],
            resource_deps=['kcp-admin extract'],
            labels='dashboard',
        )
        print('kcp portal → http://localhost:8080 (no-oidc, static image %s)' % portal_image)
else:
    # Built from source: kcp's hand-written CRs, which carry no OIDC block.
    # Rather than let the stack come up with an issuer nobody can sign in
    # with, say so.
    if DEX_ENABLED:
        fail('KCP_STATIC=false runs kcp from the hand-written CRs in the checkout, which have no OIDC issuer; ' +
             'run with DEX_ENABLED=false, or use the default KCP_STATIC=true.')
    include(KCP_TILT + '/Tiltfile')

# ── this repo's components ───────────────────────────────────────────

# The components get their own credential rather than borrowing kcp's
# admin kubeconfig, because the group it carries matters:
#
# kcp's workspace admission records the creator as the workspace owner
# (LogicalCluster.spec.createdBy) only for identities that are NOT
# system-privileged, and the apibinder initializer impersonates that owner
# to bind a new workspace's defaultAPIBindings. A workspace created by a
# system:masters client therefore has no owner and sticks in Initializing
# on system:apibindings forever.
#
# kcp's own tilt mints its admin kubeconfigs with system:masters, and the
# front-proxy hides the problem by dropping that group on ingress — but
# our operators also talk to shard-direct APIExport URLs, where it is not
# dropped. So we mint system:kcp:admin without it: admin everywhere
# through RBAC, recorded as an owner, and not dependent on how the kcp
# checkout happens to be configured.
k8s_yaml(blob("""
apiVersion: operator.kcp.io/v1alpha1
kind: Kubeconfig
metadata:
  name: contrib
  namespace: default
spec:
  username: contrib-admin
  groups: ["system:kcp:admin"]
  validity: 8766h
  secretRef:
    name: kcp-contrib-kubeconfig
  target:
    frontProxyRef:
      name: frontproxy
"""))
local_resource('contrib-kubeconfig',
    cmd='kubectl wait kubeconfig/contrib --for=create --timeout=5m && ' +
        'kubectl wait secret/kcp-contrib-kubeconfig --for=create --timeout=5m && ' +
        "kubectl get secret/kcp-contrib-kubeconfig -o jsonpath='{.data.kubeconfig}' | base64 -d > " +
        TILT_DIR + '/tilt-contrib.kubeconfig',
    resource_deps=['kcp-admin extract'],
    labels=['contrib'],
)

# Everything in this stack is addressed through one port on the host, so
# keeping it up is not a detail: lose it and every kubeconfig, the UI and
# the CLI all fail at once, which looks like the components being broken
# rather than the address being gone. Tilt restarts a serve_cmd, and the
# script re-resolves the gateway Service each time round.
local_resource('ingress-forward',
    serve_cmd='hack/tilt/ingress-forward.sh',
    deps=['hack/tilt/ingress-forward.sh'],
    readiness_probe=probe(
        period_secs=5,
        exec=exec_action(command=['sh', '-c',
            'curl -sk -o /dev/null --max-time 3 https://kcp.localhost:8443/readyz']),
    ),
    labels=['contrib'],
)

KUBECONFIG = TILT_DIR + '/tilt-contrib.kubeconfig'
FRONT_PROXY_URL = os.getenv('KCP_FRONT_PROXY_URL', 'https://kcp.localhost:8443')

# A throwaway client CA + alice/bob, so the virtual workspaces can
# authenticate direct callers during development. With dex enabled the
# same resource also mints dex's serving cert, whose CA every consumer
# (kcp via the dex-tls secret, the VWs and login via the file) trusts.
PKI_CMD = 'hack/tilt/pki.sh ' + TILT_DIR + '/pki'
if DEX_ENABLED:
    PKI_CMD += ' && hack/tilt/dex-pki.sh ' + TILT_DIR + '/dex'
local_resource('dev-pki',
    cmd=PKI_CMD,
    labels=['contrib'],
    allow_parallel=True,
)

if DEX_ENABLED:
    # The one secret both dex (tls.crt/tls.key) and the kcp shards
    # (caFileRef -> ca.crt) mount.
    local_resource('dex-secret',
        cmd='kubectl create secret generic dex-tls' +
            ' --from-file=tls.crt=' + TILT_DIR + '/dex/tls.crt' +
            ' --from-file=tls.key=' + TILT_DIR + '/dex/tls.key' +
            ' --from-file=ca.crt=' + TILT_DIR + '/dex/ca.crt' +
            ' --dry-run=client -o yaml | kubectl apply -f -',
        deps=[TILT_DIR + '/dex/tls.crt'],
        resource_deps=['dev-pki'],
        labels=['auth'],
        allow_parallel=True,
    )
    # Stamp the serving cert's fingerprint onto the pod template.
    #
    # dex reads its certificate once, at boot. Depending on dex-secret only
    # orders startup — replacing a Secret does not roll a Deployment — so a
    # regenerated cert left dex serving one that nothing trusted any more,
    # and every OIDC validator answered 401 because it could not even fetch
    # the discovery document. Making the cert part of the pod spec is what
    # ties the two together: a new cert is a new Deployment, and Tilt rolls
    # it. watch_file is what re-evaluates this when the cert changes.
    watch_file(TILT_DIR + '/dex/tls.crt')
    dex_cert_stamp = str(local(
        'shasum -a 256 %s/dex/tls.crt 2>/dev/null | cut -c1-16 || echo bootstrap' % TILT_DIR,
        quiet=True, echo_off=True)).strip()

    dex_objects = read_yaml_stream('hack/tilt/dex.yaml')
    for obj in dex_objects:
        if obj['kind'] == 'Deployment' and obj['metadata']['name'] == 'dex':
            template = obj['spec']['template']
            template.setdefault('metadata', {}).setdefault('annotations', {})
            template['metadata']['annotations']['kcp.localhost/serving-cert'] = dex_cert_stamp
    k8s_yaml(encode_yaml_stream(dex_objects))
    k8s_resource('dex', resource_deps=['dex-secret'], labels=['auth'])

    # The issuer URL must resolve on the host too (the pods get it via
    # hostAliases). Warn early instead of failing a login later.
    if str(local('grep -qs dex.kcp.localhost /etc/hosts && echo yes || echo no', quiet=True)).strip() == 'no':
        print('WARNING: dex.kcp.localhost missing from /etc/hosts — add it to the 127.0.0.1 line for login to work')

    print('dex → %s (alice@team-a.example.com / bob@team-b.example.com / mallory@strangers.example.com / admin@platform.example.com, password "password")' % DEX_ISSUER)
    print('login: bin/contribctl login --issuer %s --certificate-authority %s/dex/ca.crt' % (DEX_ISSUER, TILT_DIR))
    print('walkthrough: hack/tilt/README.md')
    print('JWT usernames arrive as the plain email, e.g. alice@team-a.example.com')

# The flags every virtual workspace shares when dex is on, mirroring the
# shard-side mapping exactly (usernameClaim email, no prefix — the
# operator's documented "oidc:" default is not actually rendered) so a
# JWT names the same user at kcp and at a VW. The issuer's CA comes from
# the same dex-tls secret the shards mount, since these now run in the
# cluster rather than on the host.
OIDC_VW_ARGS_LIST = []
if DEX_ENABLED:
    OIDC_VW_ARGS_LIST = [
        '--oidc-issuer-url=' + DEX_ISSUER,
        '--oidc-client-id=kcp',
        '--oidc-username-claim=email',
        '--oidc-groups-claim=groups',
        '--oidc-ca-file=/etc/dex/ca.crt',
    ]

DEX_VW_VOLUMES = ''
if DEX_ENABLED:
    DEX_VW_VOLUMES = """  extraVolumes:
    - name: dex-ca
      secret:
        secretName: dex-tls
        items:
          - key: ca.crt
            path: ca.crt
  extraVolumeMounts:
    - name: dex-ca
      mountPath: /etc/dex
      readOnly: true"""

def enabled(name):
    return os.getenv(name + '_ENABLED', 'true').lower() not in ('false', '0', 'no', 'off')

# Every virtual workspace answers on the front-proxy, at the path it
# owns — so a client needs exactly one address for all of kcp. The
# operator does the wiring: it deploys each virtual workspace from a
# VirtualWorkspace object (Deployment + Service on :6443), issues its
# serving certificate from the shard CA and mounts the requestheader
# client CA, and the front-proxy mappings below forward the caller's
# identity to it in X-Remote-* headers over its own client certificate.
#
# Mappings are collected here and applied to the FrontProxy at the end,
# because one patch has to carry them all.
VW_PATH_MAPPINGS = []

# The kind cluster images are side-loaded into; matches hack/tilt/up.sh.
KIND_CLUSTER = os.getenv('CLUSTER_NAME', 'kcp-tilt')

def yaml_list(items):
    """Render a list of strings as a YAML flow sequence."""
    return '[' + ', '.join(['"%s"' % i for i in items]) + ']'


def virtual_workspace(name, image_target, service, init_args, vw_args,
                      server_cmd=None, init_cmd=None):
    """Deploy one component's virtual workspace through the operator.

    server_cmd and init_cmd are the container commands. They default to
    the single-binary-with-subcommands shape tenancy and marketplace use;
    access ships separate binaries, and mcp has nothing to bootstrap at
    all, so both are overridable. init_cmd=[] means this component
    installs nothing and gets no bootstrap credential.
    """
    if server_cmd == None:
        server_cmd = ['/' + image_target, 'virtualworkspace']
    if init_cmd == None:
        init_cmd = ['/' + image_target, 'init']

    # Built and side-loaded by hand rather than with docker_build: the
    # operator composes the image as "<repository>:<tag>", so there is no
    # single field for Tilt to inject a ref into. A fixed tag plus an
    # explicit rollout restart gets the new image running.
    local_resource('%s-image' % name,
        cmd=('docker build --target %s -t %s:dev . && ' % (image_target, image_target) +
             'kind load docker-image %s:dev --name %s && ' % (image_target, KIND_CLUSTER) +
             'kubectl rollout restart deploy/%s-virtual-workspace 2>/dev/null || true' % name),
        deps=['go.mod', 'go.sum', 'Dockerfile'] + [
            p for p in [name + '/main.go', name + '/cmd', name + '/pkg',
                        name + '/internal', name + '/config', name + '/sdk']
            if os.path.exists(p)
        ],
        ignore=['**/*_test.go'],
        labels=[name],
        allow_parallel=True,
    )

    # Two credentials, because bootstrapping and serving want different
    # ones: init walks the workspace tree and installs exports (admin),
    # while the server only reads what its exports give it — init grants
    # that identity the server role with --server-user.
    bootstrap_kubeconfig = ""
    if init_cmd:
        bootstrap_kubeconfig = """apiVersion: operator.kcp.io/v1alpha1
kind: Kubeconfig
metadata:
  name: %(name)s-vw-bootstrap
  namespace: default
spec:
  username: kcp-admin
  groups: ["system:kcp:admin"]
  validity: 8766h
  secretRef:
    name: %(name)s-vw-bootstrap-kubeconfig
  target:
    frontProxyRef:
      name: frontproxy
---
""" % {'name': name}

    init_containers = ""
    if init_cmd:
        init_containers = """  initContainers:
    - name: init
      kubeconfigSecretRef:
        name: %(name)s-vw-bootstrap-kubeconfig
      command: %(init_cmd)s
      args:
        - --kubeconfig=/etc/kcp/init-kubeconfig/kubeconfig
        - --server-user=%(name)s-vw
%(init_args)s""" % {
            'name': name,
            'init_cmd': yaml_list(init_cmd),
            'init_args': init_args,
        }

    k8s_yaml(blob("""%(bootstrap_kubeconfig)sapiVersion: operator.kcp.io/v1alpha1
kind: Kubeconfig
metadata:
  name: %(name)s-vw-server
  namespace: default
spec:
  username: %(name)s-vw
  validity: 8766h
  targetWorkspace: root:%(name)s:controllers
  secretRef:
    name: %(name)s-vw-server-kubeconfig
  target:
    frontProxyRef:
      name: frontproxy
---
apiVersion: operator.kcp.io/v1alpha1
kind: VirtualWorkspace
metadata:
  name: %(name)s
  namespace: default
spec:
  target:
    rootShardRef:
      name: root
  external:
    hostname: kcp.localhost
    port: 8443
  image:
    repository: %(image)s
    tag: dev
  # One replica, small: this is a one-node development cluster. The
  # operator's default is two replicas requesting a whole CPU each, which
  # for four virtual workspaces is eight CPUs before anything else runs —
  # and a rollout adds a surge pod on top, which then cannot schedule and
  # leaves the old image serving while the new one sits Pending forever.
  replicas: 1
  resources:
    requests:
      cpu: 200m
      memory: 256Mi
  command: %(server_cmd)s
  kubeconfigSecretRef:
    name: %(name)s-vw-server-kubeconfig
%(init_containers)s
  extraArgs:
%(vw_args)s
%(dex_volumes)s
  deploymentTemplate:
    spec:
      template:
        spec:
          # The kubeconfigs address the front-proxy by its external
          # hostname, so it has to resolve in here too.
          hostAliases:
            - ip: 10.96.2.2
              hostnames: ["kcp.localhost", "root.kcp.localhost", "theseus.kcp.localhost", "dex.kcp.localhost"]
""" % {
        'name': name,
        'image': image_target,
        'server_cmd': yaml_list(server_cmd),
        'bootstrap_kubeconfig': bootstrap_kubeconfig,
        'init_containers': init_containers,
        'vw_args': vw_args,
        'dex_volumes': DEX_VW_VOLUMES,
    }))

    # The VirtualWorkspace is not a workload Tilt recognises — the
    # Deployment and Service behind it are the operator's doing — so it
    # gets no resource of its own unless one is assembled from the object.
    #
    # Deliberately NOT waiting on the two Kubeconfig resources: they have
    # no pods, so their runtime status never leaves "pending" and a
    # dependent would wait forever. The pod just stays in
    # ContainerCreating until the operator has minted their secrets.
    k8s_resource(
        new_name='%s-vw' % name,
        objects=['%s:VirtualWorkspace' % name],
        resource_deps=['%s-image' % name, 'contrib-kubeconfig'],
        labels=[name],
    )
    kubeconfigs = ['%s-vw-server' % name]
    if init_cmd:
        kubeconfigs.append('%s-vw-bootstrap' % name)
    for kubeconfig in kubeconfigs:
        k8s_resource(kubeconfig, labels=[name])

    VW_PATH_MAPPINGS.append({
        'path': '/services/' + service,
        'backend': 'https://%s-virtual-workspace.default.svc.cluster.local:6443' % name,
        # The serving certificate chains up to the root CA the front-proxy
        # already mounts, and the requestheader client certificate is how
        # the virtual workspace knows to trust the forwarded identity.
        # This is the path the operator's own default mappings use; the
        # /etc/kcp-front-proxy/tls/ca/tls.crt in its docs does not exist
        # in the deployment, and the front-proxy exits on a CA it cannot
        # read rather than serving without it.
        'backend_server_ca': '/etc/kcp/tls/ca/tls.crt',
        'proxy_client_cert': '/etc/kcp-front-proxy/requestheader-client/tls.crt',
        'proxy_client_key': '/etc/kcp-front-proxy/requestheader-client/tls.key',
    })


def component(name, binary, operator_args):
    """The component's operator, which runs as a local process: it serves
    no path, so nothing about it needs the front-proxy's routing — only
    its client credential, which is the same one everything else uses.
    """
    bin_path = 'bin/' + binary

    local_resource('%s-build' % name,
        cmd='make --no-print-directory build-%s' % name,
        deps=[p for p in [name + '/main.go', name + '/cmd', name + '/pkg',
                          name + '/internal', name + '/config', name + '/sdk']
              if os.path.exists(p)],
        ignore=['**/*_test.go'],
        labels=[name],
        allow_parallel=True,
    )

    local_resource('%s-operator' % name,
        serve_cmd='%s operator --kubeconfig %s %s --v=4' % (bin_path, KUBECONFIG, operator_args),
        deps=[bin_path],
        # The exports it reconciles are installed by the virtual
        # workspace's init container. ingress-forward is only ready once
        # kcp answers on the host, and the operator exits if it cannot
        # reach kcp at startup.
        resource_deps=['%s-build' % name, '%s-vw' % name, 'contrib-kubeconfig', 'ingress-forward'],
        labels=[name],
    )

# access — SelfClusterAccessReview: "which workspaces can this identity
# reach?" in one call. It ships separate binaries rather than one with
# subcommands, so the commands are spelled out.
if enabled('ACCESS'):
    virtual_workspace('access', 'access-vw', 'access',
        # The server kubeconfig already targets root:access:controllers, so
        # the slice is looked up there without a --workspace-path.
        init_args='',
        # Deliberately NOT --apiexport-endpointslice: that restricts access
        # to workspaces which bind its own export, which would make enabling
        # MCP two bindings rather than one. Here it indexes everything its
        # kubeconfig can see, and a caller's RBAC is what narrows the answer.
        vw_args='    - --endpoint-base=%s/clusters/\n' % FRONT_PROXY_URL +
                ''.join(['    - %s\n' % a for a in OIDC_VW_ARGS_LIST]),
        server_cmd=['/access-vw'],
        init_cmd=['/access-vw-init'],
    )
    print('access VW → %s/services/access' % FRONT_PROXY_URL)

# mcp — the Model Context Protocol over whatever the caller can reach,
# which it learns from the access VW above.
#
# It is also a marketplace offering, which is the interesting part. MCP is
# not an API, so there is nothing for a consumer to bind in order to "get"
# it; what they actually have to do is let the server act as them in their
# workspace. Its APIExport claims exactly the RBAC for that, so binding IS
# the consent, and the operator below spends those claims on the one grant.
if enabled('MCP'):
    virtual_workspace('mcp', 'mcp-vw', 'mcp',
        init_args='',
        # It reaches the access VW through the front-proxy like any other
        # client, trusting the root CA the operator mounts into every
        # virtual workspace pod.
        vw_args='    - --access-url=%s/services/access\n' % FRONT_PROXY_URL +
                '    - --access-ca-file=/etc/kcp/tls/ca/root/tls.crt\n' +
                ''.join(['    - %s\n' % a for a in OIDC_VW_ARGS_LIST]),
        server_cmd=['/mcp-virtual-workspace', 'serve'],
        init_cmd=['/mcp-virtual-workspace', 'init'],
    )
    component('mcp', 'mcp-virtual-workspace',
        operator_args='--workspace-path root:mcp:controllers ' +
                      '--apiexport-endpointslice=mcp ' +
                      '--server-url=%s/services/mcp ' % FRONT_PROXY_URL +
                      # The identity the operator mints for this VW's server
                      # kubeconfig, and so the subject the grant names.
                      '--impersonate-user=mcp-vw',
    )

    # Register the mcp workspace as a marketplace provider, so its export
    # shows up in the catalog as something to enable. Ad-hoc: it only makes
    # sense once both components are up, and publishing grants `bind` to
    # every authenticated user in this stack.
    local_resource('mcp-offering',
        cmd='hack/tilt/mcp-offering.sh',
        env={'KUBECONFIG': KUBECONFIG, 'KCP_FRONT_PROXY_URL': FRONT_PROXY_URL},
        deps=['hack/tilt/mcp-offering.sh'],
        resource_deps=['mcp-operator', 'marketplace-operator'],
        trigger_mode=TRIGGER_MODE_MANUAL,
        auto_init=False,
        labels=['mcp'],
    )
    print('mcp VW → %s/services/mcp' % FRONT_PROXY_URL)
    print('  publish it to the catalog: tilt trigger mcp-offering')

# The dex user who runs the platform: init binds it to the platform-admin
# role in the tenancy store and the marketplace catalog, and nothing else.
PLATFORM_ADMIN = 'admin@platform.example.com'
PLATFORM_ADMIN_INIT_ARGS = '        - --platform-admin-user=%s\n' % PLATFORM_ADMIN

if enabled('TENANCY'):
    virtual_workspace('tenancy', 'tenancy-vw', 'tenancy',
        init_args=PLATFORM_ADMIN_INIT_ARGS,
        # No --workspace-path: the server kubeconfig is already scoped to
        # root:tenancy:controllers by targetWorkspace, and retargeting it
        # would append a second /clusters/ segment.
        # Self-service tenants are off by default in the component; a dev
        # stack wants them on, so a fresh identity can get started without
        # an administrator.
        vw_args='    - --endpoint-base=%s/clusters/\n' % FRONT_PROXY_URL +
                '    - --self-service-tenants\n' +
                ''.join(['    - %s\n' % a for a in OIDC_VW_ARGS_LIST]),
    )
    component('tenancy', 'tenancy-vw',
        operator_args='--workspace-path root:tenancy:controllers ' +
                      '--tenants-workspace root:tenancy:tenants',
    )
    # Demo data, so a fresh environment answers whoami with something:
    # the component's own `admin seed` command converges on tenant acme
    # + project web, alice admin / bob view — each granted under both
    # identities (dex email and dev-cert CN). Idempotent; re-run anytime
    # with `tilt trigger tenancy-seed`. SEED_ENABLED=false skips it.
    if os.getenv('SEED_ENABLED', 'true').lower() not in ('false', '0', 'no', 'off'):
        local_resource('tenancy-seed',
            cmd='make --no-print-directory build-cli && ' +
                'bin/contribctl admin seed --kubeconfig ' + KUBECONFIG +
                ' --tenant acme --display-name "Acme Corp" --project web' +
                ' --admin alice@team-a.example.com --admin alice' +
                ' --view bob@team-b.example.com --view bob',
            resource_deps=['tenancy-operator'],
            labels=['tenancy'],
        )
    print('tenancy VW → %s/services/tenancy' % FRONT_PROXY_URL)

if enabled('MARKETPLACE'):
    virtual_workspace('marketplace', 'marketplace-vw', 'marketplace',
        init_args=PLATFORM_ADMIN_INIT_ARGS,
        vw_args=''.join(['    - %s\n' % a for a in OIDC_VW_ARGS_LIST]),
    )
    component('marketplace', 'marketplace-vw',
        operator_args='--workspace-path root:marketplace:controllers ' +
                      '--catalog-workspace root:marketplace:catalog ' +
                      '--producers-workspace root:marketplace:producers',
    )
    # Example offerings, on demand: `tilt trigger marketplace-examples`.
    #
    # Ad-hoc rather than automatic because an empty catalog is a legitimate
    # state to develop against — and because publishing grants `bind` to
    # every authenticated user in this stack, which should be something
    # someone asked for. auto_init=False keeps it out of `tilt up`;
    # TRIGGER_MODE_MANUAL keeps editing the examples from re-running it
    # behind your back.
    local_resource('marketplace-examples',
        cmd='KUBECONFIG=%s KCP_FRONT_PROXY_URL=%s marketplace/config/examples/apply.sh'
            % (KUBECONFIG, FRONT_PROXY_URL),
        deps=['marketplace/config/examples'],
        resource_deps=['marketplace-operator'],
        trigger_mode=TRIGGER_MODE_MANUAL,
        auto_init=False,
        labels=['marketplace'],
    )
    print('marketplace VW → %s/services/marketplace' % FRONT_PROXY_URL)
    print('  example offerings: tilt trigger marketplace-examples')

# One patch carries every mapping: the front-proxy matches the longest
# prefix, so these win over the default /services/ route to the shards.
if VW_PATH_MAPPINGS:
    local_resource('frontproxy-path-mappings',
        cmd="kubectl patch frontproxy frontproxy --type=merge -p '%s'" % encode_json(
            {'spec': {'additionalPathMappings': VW_PATH_MAPPINGS}}),
        resource_deps=['frontproxy'],
        labels=['contrib'],
    )
    print('front-proxy routes: %s' % ', '.join([m['path'] for m in VW_PATH_MAPPINGS]))
