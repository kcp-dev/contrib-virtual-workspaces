# A single-node etcd for the root shard. Storage is an emptyDir: the test's kcp lives exactly as
# long as its namespace, so there is nothing to persist, and this keeps the e2e run independent of
# whatever StorageClass the cluster happens to have.
apiVersion: v1
kind: Service
metadata:
  name: etcd
  namespace: {{ .Namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: etcd
  ports:
    - name: client
      port: 2379
      targetPort: client
    - name: peer
      port: 2380
      targetPort: peer

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: etcd
  namespace: {{ .Namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: etcd
  template:
    metadata:
      labels:
        app.kubernetes.io/name: etcd
    spec:
      automountServiceAccountToken: false
      containers:
        - name: etcd
          image: quay.io/coreos/etcd:v3.5.21
          imagePullPolicy: IfNotPresent
          command:
            - /usr/local/bin/etcd
          args:
            - --name=etcd
            - --data-dir=/data
            - --wal-dir=/data/wal
            - --listen-peer-urls=http://0.0.0.0:2380
            - --listen-client-urls=http://0.0.0.0:2379
            - --advertise-client-urls=http://etcd.{{ .Namespace }}.svc.cluster.local:2379
            - --initial-cluster-state=new
            - --initial-cluster-token=etcd
            - --initial-cluster=etcd=http://etcd.{{ .Namespace }}.svc.cluster.local:2380
            - --initial-advertise-peer-urls=http://etcd.{{ .Namespace }}.svc.cluster.local:2380
            - --listen-metrics-urls=http://0.0.0.0:8080
          ports:
            - name: client
              containerPort: 2379
            - name: peer
              containerPort: 2380
            - name: metrics
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /readyz
              port: metrics
            periodSeconds: 2
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /livez
              port: metrics
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          emptyDir: {}
