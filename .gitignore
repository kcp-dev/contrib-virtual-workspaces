*.kubeconfig

# Binaries built into component roots by `go build ./cmd/...`. They shadow
# bin/ on tab-completion and go stale silently; use `make build`.
/ephemeral/ephemeral-virtual-workspace
/ephemeral/endpointslice-controller
/ephemeral/example-webhook

.claudebin/
.DS_Store

# Self-signed serving certs a VW generates when none are supplied.
apiserver.local.config/
