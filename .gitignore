/bin/
/tenancy/bin/
*.test
cover.out

# Working directories of the e2e harnesses: kind kubeconfigs, checkouts the
# scripts deploy from, and local kcp state.
.e2e/
.e2e-*/
.kcp/
.local/
pki/
.dex/
.tilt/

# Kubeconfigs the README walkthrough writes (`tenancyctl kubeconfig -o ...`).
*.kubeconfig

# Serial files `openssl x509 -CAcreateserial` leaves beside wherever it ran.
*.srl

# Binaries built into component roots by `go build ./cmd/...`. They shadow
# bin/ on tab-completion and go stale silently; use `make build`.
/ephemeral/ephemeral-virtual-workspace
/ephemeral/endpointslice-controller
/ephemeral/example-webhook

.claudebin/
.DS_Store

# Self-signed serving certs a VW generates when none are supplied.
apiserver.local.config/
/marketplace/bin/

# The web UI's build output and dependencies. Running vitest from the repo
# root also leaves a node_modules/ cache there.
node_modules/
ui/dist/
*.tsbuildinfo
