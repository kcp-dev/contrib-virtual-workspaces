# Defaults for the Tilt stack. The UI talks only to the front-proxy: the
# dev server proxies /services and /clusters there, so the browser stays
# on one origin and kcp needs no CORS configuration.
VITE_KCP_SERVER=https://kcp.localhost:8443
VITE_KCP_INSECURE=true

# The issuer is reached by the browser directly, so it is a real URL
# rather than a proxied path.
VITE_OIDC_ISSUER=https://dex.kcp.localhost:8443/dex
VITE_OIDC_CLIENT_ID=kcp
